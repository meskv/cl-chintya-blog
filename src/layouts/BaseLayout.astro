---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  articleMeta?: {
    publishedTime: string;
    modifiedTime?: string;
    author: string;
    tags: string[];
  };
  lang?: 'en' | 'hi';
  noIndex?: boolean;
}

const {
  title,
  description = 'Chintya is a publication about ideas worth thinking about — essays and observations on philosophy, society, economics, technology and culture.',
  image = '/og-default.svg',
  articleMeta,
  lang = 'en',
  noIndex = false,
} = Astro.props;

const pageTitle = title === 'Chintya' ? title : `${title} · Chintya`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
---
<!doctype html>
<html lang={lang} class={lang === 'hi' ? 'lang-hi' : ''}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="Chintya" href="/rss.xml" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content={articleMeta ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="Chintya" />
    {articleMeta && (
      <>
        <meta property="article:published_time" content={articleMeta.publishedTime} />
        {articleMeta.modifiedTime && (
          <meta property="article:modified_time" content={articleMeta.modifiedTime} />
        )}
        <meta property="article:author" content={articleMeta.author} />
        {articleMeta.tags.map((tag) => <meta property="article:tag" content={tag} />)}
      </>
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('chintya-theme');
          if (stored) {
            document.documentElement.setAttribute('data-theme', stored);
          }
        } catch (e) {
          /* no persisted preference available */
        }
      })();
    </script>
  </head>
  <body lang={lang}>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
