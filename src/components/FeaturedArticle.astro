---
import { Image } from 'astro:assets';
import type { Article } from '../lib/utils';
import { estimateReadingTime } from '../lib/utils';
import AuthorByline from './AuthorByline.astro';

interface Props {
  article: Article;
}

const { article } = Astro.props;
const readingTime = article.data.readingTimeOverride ?? estimateReadingTime(article.body ?? '', article.data.language);
---
<article class="featured">
  {article.data.coverImage && (
    <a href={`/blog/${article.id}/`} class="featured__image">
      <Image
        src={article.data.coverImage}
        alt={article.data.coverImageAlt ?? ''}
        width={1200}
        height={800}
        loading="eager"
      />
    </a>
  )}
  <div class="featured__text">
    <p class="featured__label sans">Featured essay</p>
    <h2 class={article.data.language === 'hi' ? 'lang-hi' : ''}>
      <a href={`/blog/${article.id}/`}>{article.data.title}</a>
    </h2>
    <p class="featured__description">{article.data.description}</p>
    <AuthorByline
      authorSlug={article.data.author}
      date={article.data.publishedDate}
      language={article.data.language}
      readingTime={readingTime}
    />
  </div>
</article>

<style>
  .featured {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--space-4);
    align-items: center;
    padding-block: var(--space-4);
  }

  .featured__image {
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
  }

  .featured__image :global(img) {
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  .featured__image:hover :global(img) {
    transform: scale(1.02);
  }

  .featured__label {
    font-size: 0.85rem;
    color: var(--accent-strong);
    margin: 0 0 0.7em;
  }

  .featured__text h2 {
    font-size: clamp(1.9rem, 3.4vw, 2.6rem);
    margin-bottom: 0.55em;
  }

  .featured__text h2 a {
    text-decoration: none;
  }

  .featured__text h2 a:hover {
    color: var(--accent-strong);
  }

  .featured__description {
    color: var(--ink-soft);
    font-size: 1.08rem;
    max-width: 46ch;
  }

  @media (max-width: 820px) {
    .featured {
      grid-template-columns: 1fr;
    }
  }
</style>
