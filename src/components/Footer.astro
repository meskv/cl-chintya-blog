---
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container-wide footer-grid">
    <div class="footer-statement">
      <Logo compact />
      <p class="serif-copy">Things worth thinking about.</p>
      <span class="footer-small">An independent publication for the curious.</span>
    </div>

    <div class="footer-signup">
      <p class="eyebrow">A note, occasionally</p>
      <h2 class="serif-copy">Good ideas, delivered with room to breathe.</h2>
      <form id="newsletter-form" class="signup-form">
        <label for="footer-email" class="sr-only">Email address</label>
        <input id="footer-email" type="email" required placeholder="your@email.com" autocomplete="off" />
        <button type="submit">
          Subscribe
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17 17 7M7 7h10v10"/></svg>
        </button>
      </form>
      <div id="newsletter-success" class="signup-success" hidden>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>
        You're on the list. Thank you.
      </div>
    </div>

    <nav class="footer-links" aria-label="Footer">
      <a href="/blog">Journal</a>
      <a href="/authors">Writers</a>
      <a href="/about">About Chintya</a>
      <a href="/rss.xml">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
        RSS
      </a>
      <a href="mailto:letters@chintya.example">Write to us</a>
    </nav>
  </div>

  <div class="container-wide footer-bottom">
    <span>&copy; {year} CHINTYA</span>
    <span>Made for unhurried reading.</span>
  </div>
</footer>

<style>
  .site-footer {
    background: hsl(var(--paper-raised));
    border-top: 1px solid hsl(var(--rule));
    padding-top: 70px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr .6fr;
    gap: 8%;
    padding-bottom: 72px;
  }

  .footer-statement p {
    font: 500 1.5rem var(--font-serif);
    margin: 22px 0 7px;
  }

  .footer-small {
    color: hsl(var(--ink-faint));
    font-size: .7rem;
    font-family: var(--font-sans);
  }

  .footer-signup h2 {
    font-size: 2rem;
    font-weight: 500;
    line-height: 1.05;
    margin: 13px 0 22px;
    max-width: 360px;
  }

  .signup-form {
    display: flex;
    border-bottom: 1px solid hsl(var(--foreground));
    max-width: 400px;
  }

  .signup-form input {
    min-width: 0;
    flex: 1;
    border: 0;
    outline: none;
    background: transparent;
    color: hsl(var(--foreground));
    padding: 10px 0;
    font-size: .79rem;
    font-family: var(--font-sans);
  }

  .signup-form button {
    border: 0;
    background: none;
    cursor: pointer;
    color: hsl(var(--primary));
    display: inline-flex;
    gap: 7px;
    align-items: center;
    font-size: .71rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .08em;
    font-family: var(--font-sans);
    white-space: nowrap;
  }

  .signup-success {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: .8rem;
    padding-block: 12px;
    color: hsl(var(--primary));
    font-family: var(--font-sans);
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: .73rem;
    font-family: var(--font-sans);
  }

  .footer-links a {
    color: hsl(var(--foreground));
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    width: fit-content;
  }

  .footer-links a:hover {
    color: hsl(var(--primary));
  }

  .footer-bottom {
    border-top: 1px solid hsl(var(--rule));
    padding: 16px 0 20px;
    display: flex;
    justify-content: space-between;
    color: hsl(var(--ink-faint));
    font: .62rem var(--font-mono);
    text-transform: uppercase;
    letter-spacing: .08em;
  }

  @media (max-width: 767px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 45px;
      padding-bottom: 55px;
    }
    .footer-links {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .footer-bottom {
      gap: 8px;
      flex-direction: column;
    }
  }
</style>

<script is:inline>
  (function () {
    var form = document.getElementById('newsletter-form');
    var success = document.getElementById('newsletter-success');
    if (!form || !success) return;
    form.addEventListener('submit', function (event) {
      event.preventDefault();
      form.hidden = true;
      success.hidden = false;
    });
  })();
</script>
