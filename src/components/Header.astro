---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';

const nav = [
  { href: '/blog', label: 'Journal' },
  { href: '/authors', label: 'Writers' },
  { href: '/about', label: 'About' },
];

const currentPath = Astro.url.pathname;
---
<header class="site-header">
  <div class="container-wide header-inner">
    <Logo />

    <nav class="desktop-nav" aria-label="Primary navigation">
      {nav.map((item) => (
        <a
          href={item.href}
          class={currentPath.startsWith(item.href) ? 'nav-link active' : 'nav-link'}
        >
          {item.label}
        </a>
      ))}
      <a href="/search" class="nav-link nav-button">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path></svg>
        Search
      </a>
    </nav>

    <div class="header-actions">
      <ThemeToggle />
      <button id="menu-toggle" class="menu-button" aria-expanded="false" aria-controls="mobile-nav" type="button">
        <span class="visually-hidden">Toggle navigation</span>
        <svg class="icon-menu" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <svg class="icon-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="mobile-nav" hidden>
    {nav.map((item) => (
      <a href={item.href}>{item.label}
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17 17 7M7 7h10v10"/></svg>
      </a>
    ))}
    <a href="/search">Search
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path></svg>
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid hsl(var(--rule));
    background: hsl(var(--background) / .94);
    backdrop-filter: blur(14px);
  }

  .header-inner {
    min-height: 74px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 27px;
    margin-left: auto;
    margin-right: 34px;
  }

  .nav-link {
    color: hsl(var(--ink-faint));
    text-decoration: none;
    font-size: .72rem;
    letter-spacing: .08em;
    text-transform: uppercase;
    font-family: var(--font-sans);
    font-weight: 600;
    transition: color .2s ease;
    position: relative;
  }

  .nav-link:hover, .nav-link.active {
    color: hsl(var(--foreground));
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -29px;
    left: 0;
    width: 100%;
    height: 2px;
    background: hsl(var(--accent));
  }

  .nav-button {
    display: inline-flex;
    gap: 7px;
    align-items: center;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 13px;
  }

  .menu-button {
    border: 0;
    background: none;
    color: hsl(var(--foreground));
    cursor: pointer;
    display: none;
    place-items: center;
    padding: 6px;
  }

  .icon-close { display: none; }
  .menu-button[aria-expanded='true'] .icon-menu { display: none; }
  .menu-button[aria-expanded='true'] .icon-close { display: block; }

  .mobile-nav {
    display: none;
  }

  @media (max-width: 767px) {
    .desktop-nav { display: none; }
    .menu-button { display: grid; }
    .mobile-nav {
      flex-direction: column;
      border-top: 1px solid hsl(var(--rule));
      padding: 12px 16px 18px;
      background: hsl(var(--background));
    }
    .mobile-nav[hidden] { display: none; }
    .mobile-nav:not([hidden]) { display: flex; }
    .mobile-nav a {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 15px 0;
      border: 0;
      border-bottom: 1px solid hsl(var(--rule));
      background: transparent;
      color: hsl(var(--foreground));
      text-align: left;
      text-decoration: none;
      font-size: .78rem;
      text-transform: uppercase;
      letter-spacing: .08em;
      font-family: var(--font-sans);
      font-weight: 600;
    }
  }
</style>

<script is:inline>
  (function () {
    var toggle = document.getElementById('menu-toggle');
    var nav = document.getElementById('mobile-nav');
    if (!toggle || !nav) return;
    toggle.addEventListener('click', function () {
      var isOpen = toggle.getAttribute('aria-expanded') === 'true';
      nav.hidden = isOpen;
      toggle.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
    });
  })();
</script>
