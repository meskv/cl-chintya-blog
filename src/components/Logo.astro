---
interface Props {
  size?: 'default' | 'large';
}
const { size = 'default' } = Astro.props;
---
<a href="/" class={`logo ${size === 'large' ? 'logo--large' : ''}`} aria-label="Chintya — home">
  <span class="logo__hi" lang="hi">चिंत्य</span>
  <span class="logo__en">CHINTYA</span>
</a>

<style>
  .logo {
    display: inline-flex;
    flex-direction: column;
    line-height: 1;
    text-decoration: none;
    color: var(--ink);
  }

  .logo__hi {
    font-family: var(--font-devanagari);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--ink-faint);
    margin-bottom: 0.2em;
  }

  .logo__en {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.35rem;
    letter-spacing: 0.06em;
  }

  .logo--large .logo__hi {
    font-size: 1.4rem;
    margin-bottom: 0.35em;
  }

  .logo--large .logo__en {
    font-size: 3rem;
    letter-spacing: 0.08em;
  }

  @media (max-width: 640px) {
    .logo--large .logo__en {
      font-size: 2.1rem;
    }
  }
</style>
